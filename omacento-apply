#!/usr/bin/env bash
#
# Omacento — apply the whole accent setup from one JSON object.
#
#   omacento-apply '{"enabled":true,"holdTime":250}'
#   omacento-apply --print            # show what would be written, write nothing
#   echo '{...}' | omacento-apply -
#
# This script is the only thing that writes configuration. Panel.qml shells out
# to it, and so do the theme-set/font-set hooks, so the panel and the CLI can
# never disagree about what a setting means.
#
# It owns two files:
#   ~/.config/fcitx5/conf/omacento.conf    hold time, blocklist, accent table
#   ~/.config/fcitx5/conf/classicui.conf   font, theme, orientation
#
# It deliberately touches nothing under ~/.config/hypr. The popup is timed by
# the addon's own timer, so key repeat is none of its business.
#
# Missing keys fall back to DEFAULTS, so partial objects are fine.

set -uo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
FCITX_CONF="${OMACENTO_FCITX_CONF:-$HOME/.config/fcitx5/conf}"

PRINT_ONLY=0
case "${1:-}" in
  --print) PRINT_ONLY=1; INPUT='{}' ;;
  -)       INPUT="$(cat)" ;;
  '')      INPUT='{}' ;;
  *)       INPUT="$1" ;;
esac

export OMACENTO_INPUT="$INPUT"
export OMACENTO_FCITX_CONF="$FCITX_CONF"
export OMACENTO_PRINT_ONLY="$PRINT_ONLY"

python3 - <<'PY'
import json, os, sys

INPUT = os.environ['OMACENTO_INPUT']
CONF  = os.environ['OMACENTO_FCITX_CONF']
PRINT = os.environ['OMACENTO_PRINT_ONLY'] == '1'

# Mirrors manifest.json's barWidget.defaults and Model.js's DEFAULTS. Repeated
# because the shell hands a freshly enabled widget an empty settings object;
# without these the first write would be a half-configured addon.
DEFAULTS = {
    'enabled':   True,
    'holdTime':  250,     # ms, the addon's own timer — unrelated to key repeat
    'vertical':  False,
    'fontSize':  14,
    'font':      '',      # empty = inherit the terminal's family
    'themeSync': True,
    'blocklist': [],
}

try:
    given = json.loads(INPUT) if INPUT.strip() else {}
except json.JSONDecodeError as e:
    sys.exit(f'omacento-apply: invalid JSON: {e}')

cfg = dict(DEFAULTS)
cfg.update({k: v for k, v in given.items() if k in DEFAULTS})

hold = max(100, min(1000, int(cfg['holdTime'])))

# Window classes come from whatever is on screen, so an application chooses its
# own. A newline in one would inject arbitrary lines into this config file, so
# drop control characters rather than trusting the source.
def clean(v):
    return ''.join(ch for ch in str(v) if ch.isprintable()).strip()

blocked = [c for c in (clean(b) for b in cfg['blocklist']) if c]

lines = [
    '# Generated by omacento — edits are overwritten.',
    f"Enabled={'True' if cfg['enabled'] else 'False'}",
    f'HoldTime={hold}',
]
# An empty Table means "use the addon's built-in pt-BR ordered table". The
# option exists so a user can reorder without recompiling; the panel does not
# write it.
if blocked:
    lines.append('')
    lines.append('[Blocklist]')
    lines += [f'{i}={b}' for i, b in enumerate(blocked)]
conf = '\n'.join(lines) + '\n'

if PRINT:
    print('=== omacento.conf ===')
    print(conf)
    sys.exit(0)

path = os.path.join(CONF, 'omacento.conf')
os.makedirs(os.path.dirname(path), exist_ok=True)
tmp = path + '.omacento-tmp'
with open(tmp, 'w') as f:
    f.write(conf)
os.replace(tmp, path)
print(f'omacento-apply: wrote {path}')
PY
rc=$?
[ "$PRINT_ONLY" = "1" ] && exit $rc
[ $rc -ne 0 ] && exit $rc

# Appearance is persisted so the theme-set / font-set hooks can regenerate the
# fcitx5 theme later without being handed the settings again.
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omacento"
mkdir -p "$STATE"
python3 - "$INPUT" "$STATE/appearance.json" <<'STATEPY'
import json, sys
try:
    given = json.loads(sys.argv[1]) if sys.argv[1].strip() else {}
except json.JSONDecodeError:
    given = {}
keep = {k: given[k] for k in ('font', 'fontSize', 'vertical', 'themeSync') if k in given}
json.dump(keep, open(sys.argv[2], 'w'))
STATEPY

"$HERE/omacento-theme" || true

# Install the theme-set / font-set hooks ourselves, resolving our own path at
# run time, so a fresh clone gets theme syncing and a moved plugin directory
# heals instead of leaving a hook pointing at nothing.
for hook in theme-set font-set; do
  hook_dir="$HOME/.config/omarchy/hooks/$hook.d"
  mkdir -p "$hook_dir"
  hook_file="$hook_dir/50-omacento"
  tmp="$hook_file.omacento-tmp"
  cat > "$tmp" <<HOOK
#!/usr/bin/env bash
# Rebuild the fcitx5 accent popup theme from the new Omarchy palette or font.
# Generated by omacento-apply — edits are overwritten.
[ -x "$HERE/omacento-theme" ] || exit 0
exec "$HERE/omacento-theme"
HOOK
  chmod +x "$tmp"
  mv -f "$tmp" "$hook_file"
done

# fcitx5 only searches /usr/lib/fcitx5 for addons, and FCITX_ADDON_DIRS replaces
# that list rather than extending it — so the system directory is named here
# too, or xim, wayland and classicui disappear along with it. ExecStartPre keeps
# the addon matched to the running fcitx5 across upgrades.
DROPIN_DIR="$HOME/.config/systemd/user/omarchy-fcitx5.service.d"
DROPIN="$DROPIN_DIR/10-omacento-addon.conf"
mkdir -p "$DROPIN_DIR"
want_dropin="$(cat <<UNIT
# Generated by omacento-apply — edits are overwritten.
[Service]
Environment=FCITX_ADDON_DIRS=%h/.local/lib/fcitx5:/usr/lib/fcitx5
ExecStartPre=-$HERE/omacento-build
UNIT
)"
RESTART=0
if [ ! -f "$DROPIN" ] || [ "$(cat "$DROPIN")" != "$want_dropin" ]; then
  printf '%s\n' "$want_dropin" > "$DROPIN"
  systemctl --user daemon-reload 2>/dev/null || true
  echo "omacento-apply: updated $DROPIN"
  RESTART=1
fi

# Exit 10 means a new .so landed. fcitx5 only looks for addons at startup, so
# without this a fresh install builds everything correctly and still does
# nothing until the next login.
"$HERE/omacento-build"
[ $? -eq 10 ] && RESTART=1

# Not loaded in the process that is actually running? Then the environment or
# the .so arrived after it started, and only a restart will pick them up.
if ! busctl --user call org.fcitx.Fcitx5 /controller \
     org.fcitx.Fcitx.Controller1 GetConfig s "fcitx://config/addon/omacento" \
     >/dev/null 2>&1; then
  RESTART=1
fi

if [ "$RESTART" = "1" ]; then
  echo "omacento-apply: restarting fcitx5 so it picks up the addon"
  systemctl --user restart omarchy-fcitx5.service 2>/dev/null || true
else
  busctl --user call org.fcitx.Fcitx5 /controller \
    org.fcitx.Fcitx.Controller1 ReloadAddonConfig s omacento >/dev/null 2>&1 || true
fi
