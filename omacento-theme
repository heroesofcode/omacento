#!/usr/bin/env bash
#
# Omacento — build a fcitx5 classicui theme out of the current Omarchy theme.
#
# Called by omacento-apply, and by the theme-set / font-set hooks on their own.
# Appearance settings come from the state file omacento-apply leaves behind, so
# a hook firing hours later still uses the font size you picked in the panel.
#
# fcitx5 has no way to follow another application's colours, so the only way to
# stop the accent popup looking like a stray GTK2 dialog is to generate a theme
# and point classicui at it.

set -uo pipefail

NAME="${OMACENTO_THEME_NAME:-omacento}"
DEST="$HOME/.local/share/fcitx5/themes/$NAME"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omacento/appearance.json"

slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -s ' ' '-'; }

CUR="$(omarchy theme current 2>/dev/null)" || { echo "omacento-theme: omarchy theme current failed" >&2; exit 1; }
TDIR="$(omarchy theme dir "$(slug "$CUR")" 2>/dev/null)"
COLORS="$TDIR/colors.toml"
[ -f "$COLORS" ] || { echo "omacento-theme: no colors.toml in $TDIR" >&2; exit 1; }

mkdir -p "$DEST"
export OMACENTO_COLORS="$COLORS" OMACENTO_DEST="$DEST" OMACENTO_NAME="$NAME" \
       OMACENTO_STATE="$STATE" OMACENTO_THEME_LABEL="$CUR"

python3 <<'PY'
import json, os, re

colors_path = os.environ['OMACENTO_COLORS']
dest        = os.environ['OMACENTO_DEST']
name        = os.environ['OMACENTO_NAME']
state_path  = os.environ['OMACENTO_STATE']
label       = os.environ['OMACENTO_THEME_LABEL']

state = {}
if os.path.exists(state_path):
    try:
        state = json.load(open(state_path))
    except (json.JSONDecodeError, OSError):
        pass

if state.get('themeSync') is False:
    print('omacento-theme: theme sync off, leaving the fcitx5 theme alone')
    raise SystemExit(0)

c = {}
for line in open(colors_path):
    m = re.match(r'\s*(\w+)\s*=\s*"([^"]+)"', line)
    if m:
        c[m.group(1)] = m.group(2)

def pick(*keys, fallback='#000000'):
    for k in keys:
        if c.get(k):
            return c[k]
    return fallback

# Everything below is interpolated into ini files. None of it is hostile today,
# but a font name or theme title carrying a quote or a newline would inject
# config lines, so strip rather than trust.
def clean(v, drop='"'):
    return ''.join(ch for ch in str(v)
                   if ch.isprintable() and ch not in drop).strip()

label = clean(label)

# lighter_background rather than background: on themes whose background is pure
# black (several Omarchy ones are) a panel painted in it vanishes into the
# terminal behind it and only the border reads as a popup.
panel  = pick('lighter_background', 'background')
border = pick('accent', 'muted', 'foreground')
text   = pick('foreground')
hl_bg  = pick('selection', 'accent')
hl_fg  = pick('background', 'dark_background')

theme = f"""[Metadata]
Name={name}
Version=1
Author=omacento
Description=Generated from the Omarchy theme "{label}"
ScaleWithDPI=True

[InputPanel]
NormalColor={text}
HighlightColor={hl_fg}
PageButtonAlignment=Last Candidate

[InputPanel/TextMargin]
Left=8
Right=8
Top=5
Bottom=5

[InputPanel/ContentMargin]
Left=4
Right=4
Top=4
Bottom=4

[InputPanel/Background]
Color={panel}
BorderColor={border}
BorderWidth=2

[InputPanel/Background/Margin]
Left=2
Right=2
Top=2
Bottom=2

[InputPanel/Highlight]
Color={hl_bg}

[InputPanel/Highlight/Margin]
Left=6
Right=6
Top=4
Bottom=4

[Menu/Background]
Color={panel}
BorderColor={border}
BorderWidth=2

[Menu/Background/Margin]
Left=2
Right=2
Top=2
Bottom=2

[Menu/ContentMargin]
Left=2
Right=2
Top=2
Bottom=2

[Menu/Highlight]
Color={hl_bg}

[Menu/Highlight/Margin]
Left=5
Right=5
Top=5
Bottom=5

[Menu/Separator]
Color={border}

[Menu/TextMargin]
Left=5
Right=5
Top=5
Bottom=5
"""

tmp = os.path.join(dest, 'theme.conf.tmp')
with open(tmp, 'w') as f:
    f.write(theme)
os.replace(tmp, os.path.join(dest, 'theme.conf'))

# Font family defaults to whatever the terminal uses, so the popup matches the
# text it is appearing over rather than fcitx5's stock Sans.
family = state.get('font') or ''
if not family:
    try:
        for line in open(os.path.expanduser('~/.config/foot/foot.ini')):
            m = re.match(r'\s*font\s*=\s*([^:,\n]+)', line)
            if m:
                family = m.group(1).strip()
                break
    except OSError:
        pass
family = clean(family) or 'Sans'
size = max(6, min(72, int(state.get('fontSize') or 14)))
vertical = 'True' if state.get('vertical') else 'False'

cui_dir = os.path.expanduser('~/.config/fcitx5/conf')
os.makedirs(cui_dir, exist_ok=True)
cui = os.path.join(cui_dir, 'classicui.conf')
tmp = cui + '.tmp'
with open(tmp, 'w') as f:
    f.write(f"""# Generated by omacento — edits are overwritten.
Theme={name}
DarkTheme={name}
Font="{family} {size}"
Vertical Candidate List={vertical}
""")
os.replace(tmp, cui)

print(f'omacento-theme: "{label}" -> panel={panel} border={border} '
      f'text={text} highlight={hl_bg} | {family} {size}')
PY

busctl --user call org.fcitx.Fcitx5 /controller \
  org.fcitx.Fcitx.Controller1 ReloadAddonConfig s classicui >/dev/null 2>&1 || true
